# TaskFlow API - Environment Configuration Example
# 📝 Replace the values below with your actual local configuration and rename to .env

# 🔌 PostgreSQL Database Configuration
# For async pg connection, use the postgresql+asyncpg driver
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskflow_db

# 🔒 Security settings
# SECRET_KEY=your_super_secret_jwt_key_here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
