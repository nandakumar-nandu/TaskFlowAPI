# 🚀 TaskFlow API - Global Environment Configuration Reference
# 📝 Copy this file to '.env' and populate the actual secrets for local run.

# 🔌 1. DATABASE CONFIGURATION
# The primary database URL. Must use 'postgresql+asyncpg' as the database protocol driver
# because TaskFlow API executes asynchronous queries via SQLAlchemy.
# Example: postgresql+asyncpg://<username>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskflow_db

# 🔒 2. SECURITY CONFIGURATION
# Cryptographically secure random secret key used for signing JWT access tokens.
# Do NOT share this or commit it to source control. Generate a secure key using: openssl rand -hex 32
SECRET_KEY=placeholder_secret_key_for_development_purposes_only_change_in_production

# Hash algorithm used to encrypt and verify the JWT access token signature.
ALGORITHM=HS256

# Lifetime validity duration of generated authentication access tokens in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

